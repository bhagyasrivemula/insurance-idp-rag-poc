# Copy this file to ".env" (same folder) and fill in your keys.
# .env is ignored by git - never commit or share it.

OPENAI_API_KEY=sk-...your-key-here...

# --- LangSmith tracing (optional) -------------------------------------------
# Create a key at https://smith.langchain.com (Settings -> API Keys).
# Leave empty to disable tracing.
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=insureassist
# LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com   # only for EU-hosted LangSmith accounts

# Optional model overrides (defaults shown)
# CHAT_MODEL=gpt-4.1-mini          # answers questions
# EXTRACT_MODEL=gpt-4.1            # IDP key-fact extraction
# EMBED_MODEL=text-embedding-3-small
# EVAL_MODEL=gpt-4.1-mini          # RAGAS judge
